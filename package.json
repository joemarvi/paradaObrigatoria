{
  "name": "parada-obrigatoria",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/environment.mjs && ng serve",
    "build": "node scripts/environment.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/environment.mjs && ng test --watch=false",
    "lint": "eslint src scripts tests playwright.config.ts playwright.portal.config.ts",
    "test:e2e": "playwright test",
    "test:db": "node tests/database.test.mjs",
    "test:portal": "node scripts/test-portal.mjs"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@supabase/supabase-js": "^2.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.0.7",
    "@angular/compiler-cli": "22.2.1",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "overrides": {
